		{
			"name": "2. Customer Wallet & Transfers",
			"item": [
				{
					"name": "Get Customer Wallet Balance",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test(\"Balance is numeric integer paise\", function () {",
									"    pm.expect(typeof jsonData.data.wallet.balance).to.eql(\"number\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{customerToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/wallet",
							"host": ["{{baseUrl}}"],
							"path": ["api", "wallet"]
						},
						"description": "Fetch customer's own wallet balance in integer paise (1 INR = 100 paise)."
					}
				},
				{
					"name": "Transfer Funds (Paise)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 or 400\", function () {",
									"    pm.expect([200, 201, 400]).to.include(pm.response.code);",
									"});",
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.transaction) {",
									"    var txId = jsonData.data.transaction.transactionId || jsonData.data.transaction._id;",
									"    pm.collectionVariables.set(\"sampleTransactionId\", txId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{customerToken}}"
							},
							{
								"key": "Idempotency-Key",
								"value": "idem-demo-tx-001"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"receiverId\": \"{{sampleReceiverId}}\",\n    \"amount\": 5000,\n    \"description\": \"Coffee bill split\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/wallet/transfer",
							"host": ["{{baseUrl}}"],
							"path": ["api", "wallet", "transfer"]
						},
						"description": "Transfer funds (5000 paise = 50 INR) atomically with idempotency protection."
					}
				},
				{
					"name": "Get Own Transactions History",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{customerToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/wallet/transactions?page=1&limit=10",
							"host": ["{{baseUrl}}"],
							"path": ["api", "wallet", "transactions"],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						},
						"description": "Lists customer transaction history with direction ('debit'/'credit') and pagination."
					}
				}
			]
		},
