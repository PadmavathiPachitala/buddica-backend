# Application Port
PORT=3000

# MongoDB Connection Strings
# Development Database (Local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/fintech_dev

# Dedicated Integration Test Database (Must NOT be the development database)
# Example Local: mongodb://127.0.0.1:27017/fintech_test
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/fintech_test?retryWrites=true&w=majority
MONGO_URI_TEST=mongodb://127.0.0.1:27017/fintech_test

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRES_IN=1d

# Rate Limiting Configuration (milliseconds and max requests)
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_REGISTER_MAX=10

# Database Seed Credentials (for npm run seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=AdminSecure123!
SEED_SUPPORT_EMAIL=support@example.com
SEED_SUPPORT_PASSWORD=SupportSecure123!
